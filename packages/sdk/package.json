{
  "name": "@xadrez/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:api": "openapi-typescript ../../api/openapi.yaml -o src/generated/openapi.ts && prettier --write src/generated/openapi.ts",
    "generate:check": "openapi-typescript ../../api/openapi.yaml -o .generated-openapi.tmp.ts && prettier --write .generated-openapi.tmp.ts && node scripts/check-generated.mjs",
    "lint": "eslint .",
    "test": "pnpm generate:check && vitest run --exclude dist/**",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@xadrez/eslint-config": "workspace:*",
    "@xadrez/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
