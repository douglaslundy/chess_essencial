{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  },
  "globalEnv": [
    "API_PORT",
    "DATABASE_URL",
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "PORT",
    "REDIS_URL",
    "WEB_ORIGIN",
    "WORKER_HEALTH_PORT"
  ]
}
