{
  "name": "xadrez-essencial",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Xadrez Essencial",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "content:validate": "pnpm run content:validate:exercises && pnpm run content:validate:lessons",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "load:basic": "node scripts/basic-load.mjs",
    "sdk:generate": "pnpm --filter @xadrez/sdk generate:api",
    "db:verify-backup-restore": "bash scripts/verify-backup-restore.sh",
    "content:validate:exercises": "node scripts/validate-exercise-content.mjs",
    "content:validate:lessons": "node scripts/validate-lesson-content.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
