[Unit]
Description=Xadrez Essencial Git pull deployment
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/lundy/xadrez-essencial
# Keep HOME aligned with the user service so SSH can load the deploy key and known_hosts.
Environment=HOME=/home/lundy
Environment=XADREZ_ROOT_DIR=/home/lundy/xadrez-essencial
Environment=XADREZ_ENV_FILE=/home/lundy/xadrez-essencial/.env.vps
ExecStart=/usr/bin/bash /home/lundy/xadrez-essencial/deploy/auto-deploy.sh
TimeoutStartSec=30min

[Install]
WantedBy=default.target
