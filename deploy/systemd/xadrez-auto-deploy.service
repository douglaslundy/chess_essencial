[Unit]
Description=Xadrez Essencial Git pull deployment
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/chess/src
# HOME must be set so git/ssh find /root/.ssh/known_hosts; the repo's
# core.sshCommand supplies the read-only deploy key (do not set
# GIT_SSH_COMMAND here — it would override that config).
Environment=HOME=/root
Environment=XADREZ_ROOT_DIR=/opt/chess/src
Environment=XADREZ_ENV_FILE=/opt/chess/.env.vps
ExecStart=/usr/bin/bash /opt/chess/src/deploy/auto-deploy.sh
TimeoutStartSec=30min

[Install]
WantedBy=default.target
