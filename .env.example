NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
AUTH_ACCESS_SECRET=replace-with-random-access-secret-at-least-32-chars
AUTH_REFRESH_SECRET=replace-with-random-refresh-secret-at-least-32-chars
AUTH_VERIFICATION_SECRET=replace-with-random-verification-secret-32-chars
AUTH_IP_HASH_SECRET=replace-with-random-ip-hash-secret-at-least-32-chars
# Encrypts AI provider API keys at rest (apps/api/src/common/crypto/secret-cipher.ts).
# Required in production (apps/api and apps/worker must use the exact same value).
SETTINGS_ENCRYPTION_KEY=replace-with-random-settings-encryption-key-32-chars
AUTH_EXPOSE_VERIFICATION_TOKEN=true
METRICS_TOKEN=replace-with-random-metrics-token-at-least-24-chars
OTEL_SERVICE_NAME=xadrez-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
WORKER_HEALTH_PORT=4001
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
DATABASE_URL=postgresql://chess:chess@localhost:5432/chess
REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025

# Demo accounts are opt-in. Supply the password only through the environment.
DEMO_SEED_ENABLED=false
# DEMO_USER_PASSWORD=
