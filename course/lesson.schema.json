{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InteractiveLesson",
  "type": "object",
  "required": [
    "slug",
    "title",
    "module",
    "estimatedMinutes",
    "steps"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "module": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "sourcePages": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stepKey",
          "stepType",
          "bodyMd"
        ],
        "properties": {
          "stepKey": {
            "type": "string"
          },
          "stepType": {
            "enum": [
              "text",
              "board_instruction",
              "quiz",
              "explanation",
              "checkpoint",
              "summary"
            ]
          },
          "bodyMd": {
            "type": "string"
          },
          "initialFen": {
            "type": [
              "string",
              "null"
            ]
          },
          "orientation": {
            "enum": [
              "white",
              "black"
            ]
          },
          "expectedActions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "feedback": {
            "type": "object"
          },
          "nextStepRules": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}