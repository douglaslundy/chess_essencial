{
  "name": "@xadrez/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:import-exercises": "tsx src/database/import-exercises.ts",
    "db:rollback": "tsx src/database/migrate.ts down",
    "db:seed": "tsx src/database/seed.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed-demo": "tsx src/database/seed-demo.ts",
    "db:import-lessons": "tsx src/database/import-lessons.ts",
    "db:seed-bot-personas": "tsx src/database/seed-bot-personas.ts",
    "db:seed-learning-path": "tsx src/database/seed-learning-path.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/platform-ws": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@xadrez/chess-domain": "workspace:*",
    "@xadrez/contracts": "workspace:*",
    "@xadrez/rating-domain": "workspace:*",
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "jose": "6.2.3",
    "minio": "8.0.6",
    "nodemailer": "9.0.3",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "ws": "8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.1",
    "@types/ws": "8.18.1",
    "@xadrez/eslint-config": "workspace:*",
    "@xadrez/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.10",
    "eslint": "catalog:",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
